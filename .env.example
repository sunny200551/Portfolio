# Environment Variables Example for Sunny Pasumarthi Portfolio
# DO NOT COMMIT REAL SECRETS TO GIT

# Optional: GitHub Personal Access Token for higher rate limits during sync
GITHUB_TOKEN=

# YouTube Data API v3 Key (Google Cloud Console)
# If omitted, sync falls back to the public YouTube RSS feed automatically.
YOUTUBE_API_KEY=

# Instagram Graph API Access Token (Professional/Creator Account)
# If omitted, sync falls back to src/data/instagram.manual.ts and displays the friendly "REELS LOADING SOON" state.
INSTAGRAM_ACCESS_TOKEN=

